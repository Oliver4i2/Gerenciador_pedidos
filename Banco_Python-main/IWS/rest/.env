# No seu arquivo .env

# O 'host' é quase sempre localhost
DB_HOST=localhost

# O usuário do seu MySQL (geralmente 'root')
DB_USER=root

# A SENHA QUE VOCÊ DEFINIU QUANDO INSTALOU O MYSQL
DB_PASSWORD=root

# O nome do banco de dados que o app vai usar.
# Você talvez precise CRIAR esse banco (schema) manualmente no MySQL
# com um nome como 'iws_db', por exemplo.
DB_NAME=nome_do_banco_de_dados